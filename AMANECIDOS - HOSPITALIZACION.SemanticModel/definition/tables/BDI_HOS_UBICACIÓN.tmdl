	column 'ESTANCIA DÍA' =
			
			SWITCH(
			    TRUE(),
			    'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] < 10, "1.MENOR A 10",
			    'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] >= 10 && 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] <= 12, "2. ENTRE 10 - 12",
			    'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] > 12, "3. MAYOR A 12",
			    "Sin Dato"
			)
		lineageTag: c990a9f3-2f05-4ac0-bce4-342c5d04504d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Es_Dia_Anterior =
			
			VAR _UltimaFecha = CALCULATE(MAX('FECHA ACTUALIZACION'[LastRefresh]))
			VAR _FechaAyer = INT(_UltimaFecha) - 1
			VAR _FechaRegistro = INT('BDI_HOS_UBICACIÓN'[FEC_INGR])
			RETURN
			    IF(_FechaRegistro = _FechaAyer, 1, 0)
		formatString: 0
		lineageTag: 71be2cce-20f5-44dc-a78d-35c30484b75e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

