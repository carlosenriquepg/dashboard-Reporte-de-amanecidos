	column 'RESUMEN ESTANCIA' =
			
			IF ('BDI_HOS_UBICACIÓN'[ESTANCIA_HNERM]>=-5 && 'BDI_HOS_UBICACIÓN'[ESTANCIA_HNERM]<=10, "1. MENOR A 10",
			IF ('BDI_HOS_UBICACIÓN'[ESTANCIA_HNERM]>10 && 'BDI_HOS_UBICACIÓN'[ESTANCIA_HNERM]<=12,"2. ENTRE 10 - 12",
			IF('BDI_HOS_UBICACIÓN'[ESTANCIA_HNERM]>12,"3. MAYOR A 12")))
		lineageTag: 77bc569e-af87-4928-b096-fa2f049d1b90
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'RESUMEN ESTANCIA2' =
			
			IF ( 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] >= -5 && 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] <= 10, "1.MENOR A 10",
			IF ( 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] > 10 && 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] <= 12, "2. ENTRE 10 - 12",
			IF ( 'BDI_HOS_UBICACIÓN'[ESTANCIA.AL.SERVICIO] > 12, "3. MAYOR A 12" ) ) )
		lineageTag: fc301d95-d604-4647-a3b2-67433cbca66b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

