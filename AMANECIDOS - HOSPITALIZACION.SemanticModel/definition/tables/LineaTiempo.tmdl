table LineaTiempo
	lineageTag: 13cfcce5-d1fc-4449-9dbb-bb3ded6b131d

	measure 'Promedio Pacientes por Dia' = ```
			
			AVERAGEX(
			    FILTER(
			        VALUES('LineaTiempo'[Fecha]),
			        CALCULATE(SUM('LineaTiempo'[N° Paciente])) > 0
			    ), 
			    CALCULATE(SUM('LineaTiempo'[N° Paciente]))
			)
			```
