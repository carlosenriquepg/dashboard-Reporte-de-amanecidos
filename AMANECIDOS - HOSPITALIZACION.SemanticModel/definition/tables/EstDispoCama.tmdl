table EstDispoCama
	lineageTag: 1a087a25-f519-4a40-a118-982824800f1a

	measure OCUPADO =
			
			CALCULATE(
			    COUNTA('EstDispoCama'[CAMA]) + 0,
			    'EstDispoCama'[ESTADO_CAMA] = "OCUPADA",
			    'EstDispoCama'[TIPOCAMA] IN { "CAMA", "INCUBADORA" }
			)
		formatString: 0
		lineageTag: 99034d92-278b-495b-b25a-e392926a4655

	measure DISPONIBLE =
			
			CALCULATE(
			    COUNTA('EstDispoCama'[CAMA]) + 0,
			    'EstDispoCama'[ESTADO_CAMA] = "DISPONIBLE",
			    'EstDispoCama'[TIPOCAMA] IN { "CAMA", "INCUBADORA" }
			)
		formatString: 0
		lineageTag: 35e8c3f6-95f7-4c45-8e16-0dba9d68c7bc

	measure CAPACIDAD = [DISPONIBLE]+[OCUPADO]
		formatString: 0
		lineageTag: b133cd54-4de8-4d0a-812f-63106ceb716f

