table df_camas_gerencia_clasificacion
	lineageTag: ece60fac-fd74-4997-af2a-ee703a21eace

	measure DISPONIBLE =
			
			CALCULATE(
			    COUNTA('df_camas_gerencia_clasificacion'[TIPOCAMA]) + 0,
			    'df_camas_gerencia_clasificacion'[ESTADO_CAMA] = "DISPONIBLE"
			)
		formatString: 0
		lineageTag: d59156d2-3704-4572-8dff-9372c909122e

	measure OCUPADA =
			
			CALCULATE(
			    COUNTA('df_camas_gerencia_clasificacion'[TIPOCAMA]) + 0,
			    'df_camas_gerencia_clasificacion'[ESTADO_CAMA] = "OCUPADA"
			)
		formatString: 0
		lineageTag: 7f15367c-d90c-4ea8-931b-061b5c1cbcc0

	measure CAPACIDAD = [DISPONIBLE] + [OCUPADA]
		formatString: 0
		lineageTag: b96d808a-bcbe-4138-8a9c-4750f5b41611

